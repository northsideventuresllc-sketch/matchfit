{
  "name": "match-fit-app",
  "version": "2.0.1-beta",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && node scripts/maybe-migrate-deploy.mjs && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "db:push": "prisma generate && prisma db push",
    "db:migrate": "prisma generate && prisma migrate deploy",
    "generate": "prisma generate",
    "beta:setup": "node scripts/beta-launch-setup.mjs --db-push",
    "beta:preflight": "node --env-file=.env scripts/beta-launch-setup.mjs --preflight",
    "beta:preflight:production": "node --env-file=.env scripts/beta-launch-setup.mjs --preflight --production",
    "beta:vercel-env": "node scripts/vercel-env-push-beta.mjs",
    "stripe:setup:client-vip": "node --env-file=.env scripts/setup-client-vip-stripe.mjs",
    "stripe:setup:client-vip:vercel": "node --env-file=.env scripts/setup-client-vip-stripe.mjs --push-vercel",
    "stripe:setup:fp-tiers": "node --env-file=.env scripts/setup-fp-tier-stripe.mjs",
    "vercel:env:client-vip": "node scripts/vercel-env-set-client-vip-price.mjs --from-secrets-file",
    "vercel:env:resend": "node scripts/vercel-env-set-resend-production.mjs",
    "vercel:env:anthropic": "node scripts/vercel-env-set-anthropic-production.mjs",
    "vercel:env:ad-platform": "node scripts/vercel-env-set-ad-platform-production.mjs",
    "vercel:env:ni-brain-db": "node scripts/vercel-env-set-ni-brain-database-password.mjs",
    "bootstrap:anthropic": "node scripts/bootstrap-anthropic-platform-secret.mjs",
    "bootstrap:ni-brain": "node scripts/bootstrap-ni-brain-platform-secret.mjs",
    "ni-brain:sync": "node --env-file=.env scripts/ni-brain-sync-match-fit.mjs",
    "ni-brain:sync:verify": "node --env-file=.env scripts/ni-brain-sync-match-fit.mjs --verify-only",
    "migrate:ni-brain-content-hub": "node --env-file=.env scripts/run-ni-brain-content-hub-migration.mjs",
    "db:locks": "sh scripts/show-sqlite-db-locks.sh",
    "test:watch": "vitest",
    "seed:dashboard-demo": "tsx --env-file=.env scripts/seed-demo-client-dashboard-showcase.js",
    "seed:admin": "tsx --env-file=.env scripts/seed-bootstrap-admin.js",
    "seed:test-accounts": "node --env-file=.env scripts/seed-match-fit-dev-test-accounts.js",
    "deidentify:username": "node --env-file=.env npx tsx scripts/deidentify-usernames.ts",
    "purge:test-accounts": "node --env-file=.env npx tsx scripts/purge-launch-test-accounts.ts",
    "wipe:owner-test-accounts": "node --env-file=.env npx tsx scripts/wipe-owner-test-accounts.ts",
    "reset:owner-portals": "node --env-file=.env npx tsx scripts/reset-owner-portal-passwords.ts",
    "tos:alignment": "tsx scripts/tos-alignment-check.ts",
    "version:bump": "node scripts/bump-product-version.mjs",
    "version:verify": "node scripts/verify-product-version-bump.mjs",
    "content:calendar:sync": "bash scripts/sync-matchfit-content-calendar.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.2",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "stripe": "^22.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vercel": "^54.14.0",
    "vitest": "^3.2.4"
  }
}
