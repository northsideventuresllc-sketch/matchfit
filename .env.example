# PostgreSQL — pooled URL for the running app (Supabase: port 6543, `?pgbouncer=true&sslmode=require`).
# Copy the pooler hostname from Project Settings → Database (us-east-2 may be aws-1-…, not aws-0-…; wrong host → "tenant/user not found").
# Encode reserved characters in the password (e.g. ! → %21).
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
#
# Direct URL for `prisma migrate` / `db push` only (Supabase: host db.PROJECT_REF.supabase.co:5432, user `postgres`).
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Required for sessions and one-time codes (min 32 characters)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional: set to 0 only when running `next start` (NODE_ENV=production) on plain http://localhost — otherwise Secure cookies never stick.
# Never disable on a public HTTPS deployment.
# MATCH_FIT_COOKIE_SECURE=0

# Google Ads conversion labels (Goals → Conversions → tag setup). Label only, or full send_to `AW-…/label`.
# NEXT_PUBLIC_GOOGLE_ADS_CLIENT_SIGNUP_CONVERSION_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_TRAINER_SIGNUP_CONVERSION_LABEL=
#
# Meta Pixel (ID in src/lib/meta-pixel.ts). Events for Ads Manager / Events Manager:
#   PageView + MatchFitSiteVisit — every page (page_path param for breakdowns)
#   MatchFitSignupStep + ViewContent — signup funnel (URL steps + wizard/onboarding steps)
#   Lead — client/trainer profile created (before paid subscription for clients)
#   InitiateCheckout — Stripe subscription checkout started
#   Subscribe — client paid signup (same trigger as GOOGLE_ADS client_signup)
#   CompleteRegistration — trainer account created (same trigger as GOOGLE_ADS trainer_signup)

# Cloudflare Turnstile — bot protection on sign-up, sign-in, and Supabase Auth (captchaToken).
# Local: copy `.env.local.example` → `.env.local` (Cloudflare dummy keys; always pass on localhost).
# Production (Vercel): real keys from Turnstile dashboard (match-fit.net hostname), then redeploy.
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  → Site key (public, baked into client at build)
#   TURNSTILE_SECRET_KEY            → Secret (server + Supabase Attack Protection → Turnstile)
# Health check: GET /api/public/turnstile-status (see docs/supabase-turnstile-setup.md)
# Optional: MATCH_FIT_TURNSTILE_STRICT=1 — block sign-in when site key exists but secret is missing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: OpenAI for richer trainer service price-check copy (dashboard “Review pricing”). Without a key, benchmarks only.
# OPENAI_API_KEY=
# OPENAI_PRICE_MODEL=gpt-4o-mini
# Optional: model for chat ToS/Privacy compliance review (same OPENAI_API_KEY). Defaults to gpt-4o-mini when unset.
# OPENAI_CHAT_COMPLIANCE_MODEL=gpt-4o-mini

# Optional: Match Fit ops — POST /api/internal/safety/lift with header `x-matchfit-internal-secret`
# MATCHFIT_INTERNAL_TOOLS_SECRET=

# Optional: POST /api/cron/match-fit-tos-jobs with Authorization: Bearer <secret> (background-check renewal, session auto-complete, DIY alerts)
# CRON_SECRET=

# Optional: GET /api/admin/chat-review-queue with Authorization: Bearer <secret> (chat leakage flags)
# MATCHFIT_ADMIN_API_SECRET=

# Optional: email via Resend (https://resend.com). Production From is Match Fit noreply on match-fit.net (see src/lib/resend-client.ts).
# In NODE_ENV=development, Resend uses onboarding@resend.dev and redirects "To" to northside.ventures.llc@gmail.com.
# RESEND_API_KEY=
# Optional: override production From header (default in code). Reply-To stays support@match-fit.net.
# RESEND_FROM_EMAIL=

# Optional: Supabase Auth (PKCE email confirmation + Turnstile CAPTCHA on signUp).
# Dashboard: Authentication → Attack Protection → CAPTCHA → Cloudflare Turnstile (secret = TURNSTILE_SECRET_KEY).
# Local: use dummy secret `1x0000000000000000000000000000000AA` in Supabase when using `.env.local.example` keys.
# Redirect URLs: https://match-fit.net/auth/callback and http://localhost:3000/auth/callback
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for Resend-delivered signup verification emails (trainer/client Supabase signUp).
# Supabase Dashboard → Project Settings → API → service_role (never expose to the browser).
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_EMAIL_CALLBACK_URL=https://match-fit.net/auth/callback

# Optional: POST /api/welcome-email (or /api/internal/welcome-email) with Authorization: Bearer <secret> — sends new-user welcome (Resend SDK). Production From uses verified match-fit.net domain.
# MATCHFIT_WELCOME_EMAIL_SECRET=

# Optional: POST /api/internal/transactional-email-samples in production — Authorization: Bearer <secret> sends one sample of each transactional template to RESEND_DEV_INBOX (dev redirects to northside.ventures.llc@gmail.com). In development, no secret is required.
# MATCHFIT_TRANSACTIONAL_EMAIL_SAMPLES_SECRET=

# Optional: POST /api/welcome-email (or /api/internal/welcome-email) with Authorization: Bearer <secret> — sends new-user welcome (Resend SDK). Production From uses verified match-fit.net domain.
# MATCHFIT_WELCOME_EMAIL_SECRET=

# One-time: bootstrap staff administrator after migrations (see scripts/seed-bootstrap-admin.js).
# MATCH_FIT_BOOTSTRAP_ADMIN_PASSWORD=

# Web Push (VAPID) — free browser lock-screen notifications. Generate keys: `npx web-push generate-vapid-keys`
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_CONTACT_EMAIL=ops@yourdomain.com

# Integration tests (`src/__tests__/login-2fa.integration.test.ts`) run `prisma db push` before the suite. If Prisma refuses
# because a migration would drop data, set this to 1 only when DATABASE_URL points at a disposable database — never production.
# MATCH_FIT_INTEGRATION_TEST_DB_PUSH_ACCEPT_DATA_LOSS=1

# Optional: 32-byte AES key (base64) for encrypting OAuth refresh tokens at rest (Google Meet / Zoom / Teams). If unset, a dev key is derived from AUTH_SECRET (set explicitly in production).
# MATCHFIT_TOKEN_ENCRYPTION_KEY=

# Optional: trainer video OAuth (redirect URIs: {NEXT_PUBLIC_APP_URL}/api/trainer/oauth/<google|zoom|microsoft>/callback)
# Google Cloud Console → OAuth client: add authorized redirect URI exactly as above for "google".
# Scopes (see GOOGLE_TRAINER_VIDEO_OAUTH_SCOPES): calendar.events + userinfo.email; Meet links use Calendar conferenceData (not meetings.space.created). Authorize uses access_type=offline for refresh tokens.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ZOOM_OAUTH_CLIENT_ID=   # Same Zoom OAuth app as in Supabase — required for token refresh / meeting API after Supabase link
# ZOOM_OAUTH_CLIENT_SECRET=
# Redirect URI (Zoom Marketplace + Supabase allow list): {NEXT_PUBLIC_APP_URL}/api/trainer/oauth/zoom/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=   # Azure portal "Value" of the client secret (not the secret id)
# MICROSOFT_OAUTH_TENANT_ID=       # Optional Entra tenant UUID; when set, authorize/token use this tenant instead of "common"
# Redirect URI (Azure Entra + Supabase allow list): {NEXT_PUBLIC_APP_URL}/api/trainer/oauth/microsoft/callback
# Microsoft scopes: openid email profile offline_access Calendars.ReadWrite (Teams via calendar events — not OnlineMeetings REST)
# Supabase (Authentication → Providers → Azure): same Azure app id/secret; add the Microsoft callback URL to Supabase redirect URLs and Azure redirect URIs as required by your setup.
# Supabase (Authentication → Providers → Zoom): add Zoom client id/secret from Zoom Marketplace; allow list Supabase Auth callback on Zoom. Add this app’s /api/trainer/oauth/zoom/callback to Supabase redirect URLs.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL for Stripe Checkout return URLs (falls back to request origin if unset)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Trainer onboarding UI: displayed sign-up and background check fee amounts (USD)
# NEXT_PUBLIC_TRAINER_SIGNUP_FEE_USD="99"
# NEXT_PUBLIC_TRAINER_BACKGROUND_CHECK_FEE_USD=49

# Stripe — set all of these in Vercel (Production + Preview) and in local `.env` (never commit real keys).
# Dashboard: https://dashboard.stripe.com/apikeys (use test keys locally; live keys only on production).
# Webhook endpoint: POST https://match-fit.net/api/webhooks/stripe (events: checkout.session.completed, payment_intent.succeeded, invoice.*, customer.subscription.*)
#
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_TRAINER_BACKGROUND_CHECK_FEE_USD=49
#
# Client $10/month membership (create recurring Price in Stripe Dashboard):
# STRIPE_PRICE_ID=price_...

# Stripe Connect sample (/stripe-connect-demo) — V2 connected accounts, thin + subscription webhooks
# STRIPE_CONNECT_THIN_WEBHOOK_SECRET=whsec_...          # Thin destination → POST /api/webhooks/stripe-connect/thin
# STRIPE_CONNECT_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...   # Snapshot → POST /api/webhooks/stripe-connect/subscriptions (or reuse STRIPE_WEBHOOK_SECRET)
# STRIPE_CONNECT_PLATFORM_PRICE_ID=price_...           # Platform subscription Price billed to connected accounts
# STRIPE_CONNECT_APPLICATION_FEE_BPS=1000            # Optional: application fee on storefront checkouts (1000 = 10%)

# Launch promos (server-side): first 150 clients = 14-day trial + card required; after cap = 3-day trial or pay now.
# MATCH_FIT_CLIENT_FOUNDING_TRIAL_MAX_CLIENTS=150
# MATCH_FIT_CLIENT_FOUNDING_TRIAL_DAYS=14
# MATCH_FIT_CLIENT_POST_CAP_TRIAL_DAYS=3
# First 30 trainers: platform registration = 20% of Checkr BG fee; after cap = $100 minus BG (cents on profile).
# MATCH_FIT_TRAINER_FOUNDING_BG_PERCENT_MAX=30
# Default Checkr BG mock/webhook amount in cents when vendor price is missing locally.
# MATCH_FIT_CHECKR_DEFAULT_BG_FEE_CENTS=4900
# Checkr webhook: POST https://<your-domain>/api/webhooks/checkr — set secret in Checkr Dashboard → Developer Settings.
# Signs raw body with HMAC-SHA256 in X-Checkr-Signature (hex). Required in production.
# CHECKR_WEBHOOK_SECRET=
# Secret key from Checkr Dashboard → Account Settings → Developer Settings (HTTP Basic auth username).
# CHECKR_API_KEY=
# Package slug from Checkr Dashboard → Packages (required to send hosted apply invitations).
# CHECKR_PACKAGE_SLUG=
# Work location for Checkr compliance (two-letter state; optional city).
# CHECKR_WORK_LOCATION_STATE=GA
# CHECKR_WORK_LOCATION_CITY=Atlanta
# Force Plan B manual invite flow even when API key exists (1 = backup mode).
# MATCH_FIT_CHECKR_PLAN_B=1
# Staff inbox for Plan B background-check emails (defaults to support@match-fit.net).
# MATCH_FIT_SUPPORT_EMAIL=support@match-fit.net

# Dev-only (NODE_ENV=development): Mac shortcuts Command+Option+Shift+C (client) / Command+Option+Shift+T (trainer) jump into fixed test accounts.
# Use the same value you would type at sign-in: email, username, or phone.
# MATCH_FIT_DEV_CLIENT_IDENTIFIER=jonnybooth22@gmail.com
# MATCH_FIT_DEV_TRAINER_IDENTIFIER=jb@northsideventuresgroup.com

# Owner test accounts: `npm run seed:test-accounts` (requires MATCH_FIT_DEV_TEST_ACCOUNTS_PASSWORD).
# Reset jbfitness6299 / coachjonny22 / jobo0602 passwords and remove twofa_tester:
#   MATCH_FIT_OWNER_PORTAL_PASSWORD='…' npm run reset:owner-portals
# MATCH_FIT_DEV_TEST_ACCOUNTS_PASSWORD=

# Comma-separated trainer emails that always receive approved background check + CPT/nutrition tracks (any environment).
# Real trainers are never affected unless listed here.
# MATCH_FIT_TEST_TRAINER_EMAILS=jb@northsideventuresgroup.com

# Development only: comma-separated trainer usernames that automatically receive APPROVED CPT + nutrition credentials,
# both onboarding tracks, and placeholder cert URLs under public/dev/ (see `src/lib/trainer-dev-test-cert-sync.ts`).
# The dev shortcut trainer (MATCH_FIT_DEV_TRAINER_IDENTIFIER) is included when its username, email, or phone matches.
# MATCH_FIT_TEST_TRAINER_USERNAMES=

# Development only: when true/1/yes, every trainer session receives the same auto-approved CPT + nutrition setup as above
# (useful when you have multiple local trainer accounts and do not want to list every username).
# MATCH_FIT_DEV_APPROVE_ALL_TRAINER_CERTS=

# Development only: trainer onboarding bypass password (local only — never set in production).
# MATCH_FIT_TRAINER_ONBOARDING_DEV_PASSWORD=

# Internal QA / owner sandbox (comma-separated emails). Requires MATCH_FIT_INTERNAL_QA_ENABLED=1.
# Enables: password-based trainer onboarding bypasses (account password), client subscribe wall bypass,
# synthetic trainer/client match simulation (America/New_York daily reset), promo token wallet credits without Stripe,
# FitHub posts flagged internalQaSandboxPost (hidden from all public/client feeds), homepage user counts exclude these emails + synthetics.
# MATCH_FIT_INTERNAL_QA_ENABLED=1
# MATCH_FIT_INTERNAL_QA_CLIENT_EMAILS=owner-client@example.com
# MATCH_FIT_INTERNAL_QA_TRAINER_EMAILS=owner-trainer@example.com
#
# Seed script: scripts/seed-match-fit-internal-qa-accounts.ts (see file header for required MATCH_FIT_INTERNAL_QA_SEED_* vars).

# Development only: comma-separated trainer usernames used for idempotent FitHub demo posts (see `lib/client-fithub-sample-posts.ts`).
# If unset, demo posts are assigned to the earliest-created trainers in the database.
# MATCH_FIT_FITHUB_DEMO_TRAINER_USERNAMES=

# --- Atlanta public beta caps & waitlist (set MATCH_FIT_BETA_GATES_ENABLED=1 in production beta) ---
# MATCH_FIT_BETA_GATES_ENABLED=1
# MATCH_FIT_BETA_MAX_TRAINERS=10
# MATCH_FIT_BETA_MAX_CLIENTS=50
# Comma-separated emails excluded from cap counts (test / staff accounts).
# MATCH_FIT_BETA_EXCLUDE_CAP_COUNT_EMAILS=you+test@example.com
# Also excluded automatically from founding/beta counters (no env required): owner seed emails
# (jonnybooth22@gmail.com, jb@northsideventuresgroup.com, jb@match-fit.net), jbfitness6299, coachjonny22,
# INTERNAL_QA_* emails, MATCH_FIT_TEST_TRAINER_EMAILS, dev identifiers, twofa_tester / @example.test, *.invalid emails,
# mfqsc_/mfqst_ usernames,
# and trainers with /dev/fake-* certification placeholder URLs.
# Comma-separated usernames excluded from cap counts (optional; jbfitness6299 is built-in).
# MATCH_FIT_BETA_EXCLUDE_CAP_COUNT_USERNAMES=jbfitness6299,other_test_user
# Internal QA seed emails (MATCH_FIT_INTERNAL_QA_*_EMAILS) are also excluded from launch/beta/home counters automatically.
# To remove test rows from production counts entirely: node --env-file=.env npx tsx scripts/purge-launch-test-accounts.ts --apply
# Optional: extra 5-digit ZIPs allowed beyond the built-in Atlanta metro list.
# MATCH_FIT_BETA_EXTRA_SERVICE_ZIPS=30094,30189
# Days an invited waitlist user has to finish signup (default 30). Cron fills slots every 15 min via GitHub Actions
# (.github/workflows/match-fit-tos-cron.yml) or Vercel Pro crons — see vercel.cron.pro.example.json.
# MATCH_FIT_BETA_INVITE_SLOT_DAYS=30
# CRON_SECRET=  (Bearer token for GET/POST /api/cron/match-fit-tos-jobs — Vercel Cron uses GET; also runs beta waitlist promotion)
#
# --- Quick local beta setup (generates .env + secrets file) ---
# npm run beta:setup
# Then add Stripe + Resend keys to .env, copy secrets to Vercel Production, redeploy:
# npm run beta:preflight
# npm run beta:vercel-env   (requires: npx vercel link)
