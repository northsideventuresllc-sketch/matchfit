# Copy this file to `.env.local` for local development (`.env.local` is gitignored).
#
# Cloudflare Turnstile — universal test keys (always pass; no live quota on localhost).
# Use the same secret in Supabase Dashboard → Authentication → Attack Protection → CAPTCHA → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Supabase (optional — email confirmation + captcha on auth.signUp)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_EMAIL_CALLBACK_URL=http://localhost:3000/auth/callback

# Required for sessions locally
# AUTH_SECRET=dev-only-auth-secret-32chars-min!!
